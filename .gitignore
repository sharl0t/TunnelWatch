# ==========================================================================
# .gitignore (стандартный чёрный список)
# ==========================================================================

# 1. Python-кэш и артефакты
__pycache__/
*.py[cod]
*.pyo

# 2. Конфигурация и служебные файлы Roo
.roo*
.roo/
.rooignore
.roorules
.roomodes

# 3. Виртуальные окружения
.venv/
venv/
env/
ENV/

# 4. Логи, базы данных, временные и системные файлы
*.log
*.sqlite
*.sqlite3
*.db
.DS_Store
Thumbs.db

# 5. Временные файлы редакторов и систем
*.swp
*.swo
*~